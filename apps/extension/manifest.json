{
  "manifest_version": 3,
  "name": "知径 · Knora 网页采集",
  "description": "保存网页正文、选中片段及图片到本机 Knora 知识库。",
  "version": "0.1.3",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "保存到 Knora",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/toolbar-filled-16.png",
      "24": "icons/toolbar-filled-24.png",
      "32": "icons/toolbar-filled-32.png",
      "48": "icons/toolbar-filled-48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
